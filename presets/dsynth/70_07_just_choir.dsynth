# Just-intonation choir pad, tuned to C: major chords on C, F and G ring with perfectly still,
# beatless thirds and fifths. Set Tuning Root to the key you play in (or Equal for anything else).
name = Just Choir (C)
category = Pads & Strings
osc1_wave = Saw
osc1_level = 0.6
osc2_on = on
osc2_wave = Triangle
osc2_range = 4'
osc2_level = 0.4
noise_level = 0.04
noise_colour = Pink
filter_model = SEM 12dB
filter_cutoff = 1400
filter_reso = 0.35
filter_env_amt = 0.1
fenv_attack = 0.8
fenv_decay = 1
fenv_sustain = 0.8
fenv_release = 1.5
aenv_attack = 0.7
aenv_decay = 1
aenv_sustain = 1
aenv_release = 1.8
drift = 0.1
tolerance = 0.1
tuning = Just (5-limit)
tuning_root = C
voice_mode = Poly
pan_spread = 0.6
chorus_mode = II
reverb_mix = 0.4
reverb_size = 0.8
reverb_decay = 4
master_volume = -13.6
