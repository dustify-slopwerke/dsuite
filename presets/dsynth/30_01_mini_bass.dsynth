# Classic fat mono bass: two detuned 16' oscillators plus a 32' sub, punchy filter contour
name = Mini Bass
category = Bass
osc1_wave = Saw
osc1_range = 16'
osc1_level = 0.9
osc2_on = on
osc2_wave = Square
osc2_range = 16'
osc2_tune = 0.07
osc2_level = 0.7
osc3_on = on
osc3_wave = Saw
osc3_range = 32'
osc3_level = 0.5
mixer_drive = 6
filter_cutoff = 260
filter_reso = 0.35
filter_env_amt = 0.55
filter_keytrack = 1/3
fenv_attack = 0.003
fenv_decay = 0.35
fenv_sustain = 0.15
fenv_release = 0.12
aenv_attack = 0.002
aenv_decay = 0.5
aenv_sustain = 0.8
aenv_release = 0.08
voice_mode = Mono
note_priority = Low
drift = 0.25
master_volume = -8.9
