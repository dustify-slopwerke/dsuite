# SEM notch: the filter sits between low- and high-pass, an LFO sweeps the notch through the pad
name = SEM Notch Pad
category = Pads & Strings
osc1_wave = Saw
osc1_level = 0.7
osc2_on = on
osc2_wave = Pulse
osc2_pw = 0.3
osc2_tune = -0.08
osc2_level = 0.6
filter_model = SEM 12dB
filter_shape = 0.5
filter_cutoff = 1200
filter_reso = 0.5
filter_env_amt = 0
lfo_rate = 0.25
lfo_wave = Triangle
mx1_source = LFO
mx1_dest = Cutoff
mx1_amount = 0.35
aenv_attack = 0.5
aenv_decay = 1
aenv_sustain = 1
aenv_release = 1.2
voice_mode = Poly
pan_spread = 0.6
drift = 0.4
chorus_mode = I
master_volume = -16
