# Prince, "1999" (1982): the detuned Oberheim OB-Xa stabs. Two wide-detuned saws and a pulse
# driven into the CEM filter with a fast, hard contour; drier and tighter than Jump.
name = 1999 (OB-Xa)
category = '80s Songs
osc1_wave = Saw
osc1_level = 0.8
osc2_on = on
osc2_wave = Saw
osc2_tune = 0.15
osc2_level = 0.8
osc3_on = on
osc3_wave = Pulse
osc3_range = 8'
osc3_pw = 0.4
osc3_tune = -0.1
osc3_level = 0.5
mixer_drive = 9
filter_model = CEM 24dB
filter_cutoff = 1100
filter_reso = 0.15
filter_env_amt = 0.5
filter_keytrack = 2/3
filter_vel = 0.35
fenv_attack = 0.001
fenv_decay = 0.22
fenv_sustain = 0.25
fenv_release = 0.2
aenv_attack = 0.002
aenv_decay = 0.3
aenv_sustain = 0.7
aenv_release = 0.2
voice_mode = Poly
pan_spread = 0.6
drift = 0.45
tolerance = 0.6
chorus_mode = I
reverb_mix = 0.12
reverb_size = 0.4
reverb_decay = 1.2
master_volume = -20.3
