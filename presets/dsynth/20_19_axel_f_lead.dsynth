# Harold Faltermeyer, "Axel F" (1984): the Jupiter-8 lead. Square plus a slightly detuned saw,
# snappy filter and amp, wheel for vibrato, a touch of ping-pong echo.
name = Axel F (Jupiter-8 Lead)
category = '80s Songs
osc1_wave = Square
osc1_level = 0.8
osc2_on = on
osc2_wave = Saw
osc2_tune = 0.07
osc2_level = 0.55
filter_model = IR3109 24dB
filter_cutoff = 2200
filter_reso = 0.25
filter_env_amt = 0.3
filter_keytrack = 2/3
fenv_attack = 0.001
fenv_decay = 0.25
fenv_sustain = 0.5
fenv_release = 0.15
aenv_attack = 0.001
aenv_decay = 0.3
aenv_sustain = 0.8
aenv_release = 0.15
voice_mode = Mono
note_priority = Last
mod_source = LFO
mod_filter = off
lfo_wave = Sine
lfo_rate = 5.5
drift = 0.3
delay_mode = Ping-Pong
delay_note = 1/8 D
delay_feedback = 0.25
delay_mix = 0.15
reverb_mix = 0.15
master_volume = -11.8
