# Jean-Michel Jarre, "Oxygene (Part IV)" (1976): the reedy lead. Narrow pulse through the 12 dB
# state-variable filter, a short slide, per-note vibrato that fades in, long echoes and chorus.
name = Oxygene IV (Lead)
category = '70s Songs
osc1_wave = Pulse
osc1_pw = 0.2
osc1_level = 0.8
osc2_on = on
osc2_wave = Saw
osc2_tune = 0.1
osc2_level = 0.3
filter_model = SEM 12dB
filter_cutoff = 2200
filter_reso = 0.3
filter_env_amt = 0.15
filter_keytrack = 2/3
fenv_attack = 0.02
fenv_decay = 0.6
fenv_sustain = 0.7
aenv_attack = 0.02
aenv_sustain = 1
aenv_release = 0.5
voice_mode = Legato
note_priority = Last
glide_time = 0.05
glide_mode = Legato Only
mx1_source = LFO 2
mx1_dest = Pitch
mx1_amount = 0.1
lfo2_rate = 5.5
lfo2_wave = Sine
lfo2_delay = 0.5
drift = 0.4
chorus_mode = I
delay_mode = Ping-Pong
delay_note = 1/4 D
delay_feedback = 0.45
delay_tone = 3500
delay_mix = 0.3
reverb_mix = 0.35
reverb_size = 0.8
reverb_decay = 4
master_volume = -12.9
