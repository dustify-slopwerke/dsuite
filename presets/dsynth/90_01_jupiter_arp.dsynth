# Arpeggiated Jupiter sequence: hold a chord. Up & Down over two octaves, 12 dB filter
name = Jupiter Arp
category = Sequences & Arps
osc1_wave = Pulse
osc1_pw = 0.3
osc1_level = 0.7
osc2_on = on
osc2_wave = Saw
osc2_range = 4'
osc2_tune = 0.05
osc2_level = 0.45
filter_model = IR3109 12dB
filter_cutoff = 1200
filter_reso = 0.5
filter_env_amt = 0.4
fenv_attack = 0.001
fenv_decay = 0.18
fenv_sustain = 0.1
fenv_release = 0.1
aenv_attack = 0.001
aenv_decay = 0.25
aenv_sustain = 0.6
aenv_release = 0.12
voice_mode = Poly
pan_spread = 0.5
arp_on = on
arp_mode = Up & Down
arp_octaves = 2
arp_rate = 1/16
arp_gate = 0.6
drift = 0.3
chorus_mode = I
master_volume = -6.9
delay_mode = Ping-Pong
delay_note = 1/8 D
delay_feedback = 0.35
delay_tone = 4000
delay_mix = 0.25
reverb_mix = 0.15
