# Vangelis, "Chariots of Fire" (1981): bright CS-80 brass. Saw and pulse through a high-passed
# 12 dB filter; press harder (aftertouch) to open it, vibrato fades in on held notes. Long hall.
name = Chariots of Fire (CS-80)
category = '80s Songs
osc1_wave = Saw
osc1_level = 0.75
osc2_on = on
osc2_wave = Pulse
osc2_pw = 0.4
osc2_tune = 0.06
osc2_level = 0.55
vhpf_cutoff = 150
filter_model = IR3109 12dB
filter_cutoff = 1100
filter_reso = 0.2
filter_env_amt = 0.4
filter_vel = 0.4
fenv_attack = 0.06
fenv_decay = 0.9
fenv_sustain = 0.55
fenv_release = 0.8
aenv_attack = 0.04
aenv_decay = 1.2
aenv_sustain = 0.8
aenv_release = 1.2
amp_vel = 0.3
mx1_source = Aftertouch
mx1_dest = Cutoff
mx1_amount = 0.3
mx2_source = LFO 2
mx2_dest = Pitch
mx2_amount = 0.07
lfo2_rate = 5.5
lfo2_wave = Sine
lfo2_delay = 0.6
voice_mode = Poly
pan_spread = 0.4
drift = 0.35
chorus_mode = I
reverb_mix = 0.4
reverb_size = 0.8
reverb_decay = 4.5
reverb_predelay = 25
master_volume = -12.6
