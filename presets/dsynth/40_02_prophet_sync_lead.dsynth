# The classic: osc 1 hard-synced to a silent osc 2, filter envelope sweeping osc 1 via Poly-Mod
name = Prophet Sync Lead
category = Leads
osc1_wave = Saw
osc1_range = 8'
osc1_tune = 3
osc1_sync = on
osc1_level = 0.9
osc2_on = off
osc2_wave = Saw
osc2_range = 8'
pm_fenv = 0.6
pm_freq = on
filter_model = CEM 24dB
filter_cutoff = 2400
filter_reso = 0.25
filter_env_amt = 0.25
fenv_attack = 0.003
fenv_decay = 0.7
fenv_sustain = 0.15
fenv_release = 0.3
aenv_attack = 0.003
aenv_decay = 0.3
aenv_sustain = 1
aenv_release = 0.2
voice_mode = Legato
note_priority = Last
glide_time = 0.04
glide_mode = Legato Only
drift = 0.3
master_volume = -4