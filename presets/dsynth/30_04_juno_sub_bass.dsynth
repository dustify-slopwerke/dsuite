# Round Juno bass: pulse plus a strong sub, snappy filter, no chorus
name = Juno Sub Bass
category = Bass
osc_type = DCO
phase_reset = on
osc1_wave = Pulse
osc1_range = 16'
osc1_pw = 0.4
osc1_level = 0.7
sub_level = 0.8
filter_model = IR3109 24dB
filter_cutoff = 280
filter_reso = 0.35
filter_env_amt = 0.45
filter_keytrack = 1/3
fenv_attack = 0.001
fenv_decay = 0.25
fenv_sustain = 0.1
fenv_release = 0.1
aenv_attack = 0.001
aenv_decay = 0.4
aenv_sustain = 0.8
aenv_release = 0.08
voice_mode = Poly
drift = 0.15
master_volume = -15.5