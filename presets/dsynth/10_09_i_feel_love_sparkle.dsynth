# Donna Summer, "I Feel Love" (1977): the bright high sequence that sparkles over the bass. Hold a
# chord high up: fast 16ths over two octaves, tiny plucks and a ping-pong echo.
name = I Feel Love (Sparkle Arp)
category = '70s Songs
osc1_wave = Square
osc1_level = 0.75
osc2_on = on
osc2_wave = Saw
osc2_range = 4'
osc2_level = 0.3
filter_cutoff = 1500
filter_reso = 0.35
filter_env_amt = 0.4
filter_keytrack = 2/3
fenv_attack = 0.001
fenv_decay = 0.1
fenv_sustain = 0
fenv_release = 0.08
aenv_attack = 0.001
aenv_decay = 0.12
aenv_sustain = 0
aenv_release = 0.08
voice_mode = Mono
note_priority = Last
arp_on = on
arp_mode = Up
arp_rate = 1/16
arp_octaves = 2
arp_gate = 0.5
arp_tempo = 128
drift = 0.2
delay_mode = Ping-Pong
delay_note = 1/8
delay_feedback = 0.3
delay_tone = 5000
delay_mix = 0.25
reverb_mix = 0.15
master_volume = 2.7
