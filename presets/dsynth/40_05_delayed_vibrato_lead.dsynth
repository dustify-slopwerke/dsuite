# Expressive lead: each note starts dead straight and a per-voice vibrato (LFO 2) fades in after
# about half a second, the way a player would add it. Aftertouch brightens it.
name = Delayed Vibrato Lead
category = Leads
osc1_wave = Saw
osc1_level = 0.8
osc2_on = on
osc2_wave = Pulse
osc2_pw = 0.35
osc2_tune = 0.09
osc2_level = 0.55
filter_model = CEM 24dB
filter_cutoff = 1500
filter_reso = 0.3
filter_env_amt = 0.3
filter_keytrack = 2/3
fenv_attack = 0.01
fenv_decay = 0.5
fenv_sustain = 0.6
aenv_attack = 0.008
aenv_sustain = 1
aenv_release = 0.3
mx1_source = LFO 2
mx1_dest = Pitch
mx1_amount = 0.1
mx2_source = Aftertouch
mx2_dest = Cutoff
mx2_amount = 0.3
lfo2_rate = 5.8
lfo2_wave = Sine
lfo2_delay = 0.6
voice_mode = Legato
note_priority = Last
glide_time = 0.04
glide_mode = Legato Only
drift = 0.35
delay_mode = Stereo
delay_note = 1/4
delay_feedback = 0.3
delay_mix = 0.15
reverb_mix = 0.2
master_volume = -9.7
