# Harold Faltermeyer, "Axel F" (1984): the Minimoog bass line under the lead. Saw, square and a 32'
# saw, short and punchy, low-note priority.
name = Axel F (Minimoog Bass)
category = '80s Songs
osc1_wave = Saw
osc1_range = 16'
osc1_level = 0.85
osc2_on = on
osc2_wave = Square
osc2_range = 16'
osc2_tune = 0.05
osc2_level = 0.7
osc3_on = on
osc3_wave = Saw
osc3_range = 32'
osc3_level = 0.35
mixer_drive = 5
filter_cutoff = 420
filter_reso = 0.3
filter_env_amt = 0.5
filter_keytrack = 1/3
fenv_attack = 0.001
fenv_decay = 0.18
fenv_sustain = 0.1
fenv_release = 0.08
aenv_attack = 0.002
aenv_decay = 0.25
aenv_sustain = 0.5
aenv_release = 0.06
voice_mode = Mono
note_priority = Low
drift = 0.25
master_volume = -4.8
