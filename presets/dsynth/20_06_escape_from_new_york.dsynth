# John Carpenter, "Escape from New York" (1981): the dark Prophet-5 bass ostinato. Saw and pulse
# at 16' into a low CEM filter with a short, punchy contour.
name = Escape from NY (Prophet-5)
category = '80s Songs
osc1_wave = Saw
osc1_range = 16'
osc1_level = 0.85
osc2_on = on
osc2_wave = Pulse
osc2_range = 16'
osc2_pw = 0.4
osc2_tune = 0.05
osc2_level = 0.6
filter_model = CEM 24dB
filter_cutoff = 280
filter_reso = 0.35
filter_env_amt = 0.4
filter_keytrack = 1/3
fenv_attack = 0.002
fenv_decay = 0.35
fenv_sustain = 0.15
fenv_release = 0.2
aenv_attack = 0.002
aenv_decay = 0.5
aenv_sustain = 0.6
aenv_release = 0.25
voice_mode = Poly
key_assign = Rotate
drift = 0.35
tolerance = 0.5
reverb_mix = 0.2
reverb_decay = 2
master_volume = -7.8
