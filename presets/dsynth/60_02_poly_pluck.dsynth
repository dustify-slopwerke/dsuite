# Poly pluck keys: saw and pulse with a quick filter pluck. Key assign Poly 2 reuses the lowest
# voice, so repeated notes cut each other off cleanly like a Jupiter-8 in Poly 2.
name = Poly Pluck (Poly 2)
category = Keys & Plucks
osc1_wave = Saw
osc1_level = 0.75
osc2_on = on
osc2_wave = Pulse
osc2_pw = 0.3
osc2_tune = 0.06
osc2_level = 0.5
filter_model = IR3109 24dB
filter_cutoff = 900
filter_reso = 0.25
filter_env_amt = 0.5
filter_keytrack = 2/3
filter_vel = 0.3
fenv_attack = 0.001
fenv_decay = 0.3
fenv_sustain = 0.1
fenv_release = 0.3
aenv_attack = 0.001
aenv_decay = 0.6
aenv_sustain = 0.2
aenv_release = 0.4
amp_vel = 0.3
voice_mode = Poly
key_assign = Poly 2
pan_spread = 0.4
drift = 0.3
chorus_mode = I
delay_mode = Ping-Pong
delay_note = 1/8 D
delay_feedback = 0.3
delay_mix = 0.18
reverb_mix = 0.15
master_volume = -8.5
