# Herbie Hancock, "Chameleon" (1973): the ARP Odyssey bass. Saw and pulse at 16' into the ARP
# ladder with a squelchy contour; harder playing opens the filter further.
name = Chameleon (ARP Odyssey)
category = '70s Songs
osc1_wave = Saw
osc1_range = 16'
osc1_level = 0.85
osc2_on = on
osc2_wave = Pulse
osc2_range = 16'
osc2_pw = 0.3
osc2_tune = 0.05
osc2_level = 0.6
mixer_drive = 6
filter_model = ARP 24dB
filter_cutoff = 350
filter_reso = 0.45
filter_env_amt = 0.5
filter_keytrack = 1/3
filter_vel = 0.3
fenv_attack = 0.002
fenv_decay = 0.3
fenv_sustain = 0.25
fenv_release = 0.1
aenv_attack = 0.002
aenv_decay = 0.4
aenv_sustain = 0.7
aenv_release = 0.08
voice_mode = Mono
note_priority = Low
drift = 0.3
master_volume = -12.5
