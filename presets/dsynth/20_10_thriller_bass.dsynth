# Michael Jackson, "Thriller" (1982): the Minimoog bass line. Saw, square and a 32' saw with a
# tight, funky filter contour; velocity adds bite.
name = Thriller (Minimoog Bass)
category = '80s Songs
osc1_wave = Saw
osc1_range = 16'
osc1_level = 0.85
osc2_on = on
osc2_wave = Square
osc2_range = 16'
osc2_tune = 0.05
osc2_level = 0.6
osc3_on = on
osc3_wave = Saw
osc3_range = 32'
osc3_level = 0.4
mixer_drive = 6
filter_cutoff = 380
filter_reso = 0.3
filter_env_amt = 0.45
filter_keytrack = 1/3
filter_vel = 0.3
fenv_attack = 0.002
fenv_decay = 0.2
fenv_sustain = 0.15
fenv_release = 0.1
aenv_attack = 0.002
aenv_decay = 0.3
aenv_sustain = 0.6
aenv_release = 0.06
amp_vel = 0.2
voice_mode = Mono
note_priority = Low
drift = 0.25
master_volume = -6.5
