# Parliament, "Flash Light" (1977): Bernie Worrell's stacked Minimoog bass. Three saws (one at
# 32'), driven, with a rubbery filter contour and a quick slide between legato notes.
name = Flash Light (Minimoog Bass)
category = '70s Songs
osc1_wave = Saw
osc1_range = 16'
osc1_level = 0.85
osc2_on = on
osc2_wave = Saw
