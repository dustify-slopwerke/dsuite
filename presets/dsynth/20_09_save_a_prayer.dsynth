# Duran Duran, "Save a Prayer" (1982): Nick Rhodes' Jupiter-8 arpeggio. Hold a chord: soft squares
# run up and down two octaves with long tails, chorus, dotted echo and reverb.
name = Save a Prayer (Jupiter-8)
category = '80s Songs
osc1_wave = Square
osc1_level = 0.75
osc2_on = on
osc2_wave = Square
osc2_range = 4'
osc2_tune = 0.03
osc2_level = 0.35
filter_model = IR3109 24dB
filter_cutoff = 1600
filter_reso = 0.3
filter_env_amt = 0.35
filter_keytrack = 2/3
fenv_attack = 0.001
fenv_decay = 0.3
fenv_sustain = 0.2
fenv_release = 0.4
aenv_attack = 0.001
aenv_decay = 0.6
aenv_sustain = 0.3
aenv_release = 0.5
voice_mode = Poly
pan_spread = 0.5
arp_on = on
arp_mode = Up & Down
arp_rate = 1/16
arp_octaves = 2
arp_gate = 0.7
arp_tempo = 132
drift = 0.3
chorus_mode = I
delay_mode = Ping-Pong
delay_note = 1/8 D
delay_feedback = 0.35
delay_mix = 0.25
reverb_mix = 0.35
reverb_decay = 3.5
master_volume = -11.2
