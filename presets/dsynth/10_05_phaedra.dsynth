# Tangerine Dream, "Phaedra" (1974): a Berlin School Moog sequence. Hold a chord: the arpeggiator
# runs it up over two octaves while a very slow LFO sweeps the resonant filter. Echo and a long hall.
name = Phaedra (Moog Sequence)
category = '70s Songs
osc1_wave = Saw
osc1_range = 16'
osc1_level = 0.8
osc2_on = on
osc2_wave = Square
osc2_range = 16'
osc2_tune = 0.06
osc2_level = 0.5
filter_cutoff = 650
filter_reso = 0.65
filter_env_amt = 0.35
filter_keytrack = 1/3
fenv_attack = 0.001
fenv_decay = 0.15
fenv_sustain = 0
fenv_release = 0.1
aenv_attack = 0.001
aenv_decay = 0.2
aenv_sustain = 0.3
aenv_release = 0.15
lfo_rate = 0.07
lfo_wave = Triangle
mx1_source = LFO
mx1_dest = Cutoff
mx1_amount = 0.25
voice_mode = Mono
note_priority = Last
arp_on = on
arp_mode = Up
arp_rate = 1/16
arp_octaves = 2
arp_gate = 0.5
arp_tempo = 110
drift = 0.5
delay_mode = Ping-Pong
delay_note = 1/8 D
delay_feedback = 0.4
delay_tone = 3000
delay_mix = 0.25
reverb_mix = 0.3
reverb_size = 0.75
reverb_decay = 4
master_volume = 1.6
