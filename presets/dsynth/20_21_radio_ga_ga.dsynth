# Queen, "Radio Ga Ga" (1984): the synced Jupiter-8 bass arpeggio. Hold a chord low on the keyboard:
# 16ths in time with the host, resonant and bouncy.
name = Radio Ga Ga (Jupiter-8)
category = '80s Songs
osc1_wave = Saw
osc1_range = 16'
osc1_level = 0.8
osc2_on = on
osc2_wave = Pulse
osc2_range = 16'
osc2_pw = 0.3
osc2_tune = 0.04
osc2_level = 0.55
filter_model = IR3109 24dB
filter_cutoff = 500
filter_reso = 0.45
filter_env_amt = 0.35
filter_keytrack = 1/3
fenv_attack = 0.001
fenv_decay = 0.12
fenv_sustain = 0.1
fenv_release = 0.08
aenv_attack = 0.001
aenv_decay = 0.15
aenv_sustain = 0.5
aenv_release = 0.08
voice_mode = Poly
arp_on = on
arp_mode = Up
arp_rate = 1/16
arp_gate = 0.5
arp_tempo = 112
drift = 0.25
reverb_mix = 0.1
master_volume = -2.6
