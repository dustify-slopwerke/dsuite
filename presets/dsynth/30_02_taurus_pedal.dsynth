# Huge pedal-style low end: 32' saws, driven ladder, long decay
name = Taurus-ish Pedal
category = Bass
osc1_wave = Saw
osc1_range = 32'
osc1_level = 0.9
osc2_on = on
osc2_wave = Saw
osc2_range = 32'
osc2_tune = 0.1
osc2_level = 0.9
osc3_on = on
osc3_wave = Saw
osc3_range = 16'
osc3_level = 0.5
mixer_drive = 9
filter_cutoff = 180
filter_reso = 0.3
filter_env_amt = 0.5
filter_keytrack = 1/3
fenv_attack = 0.005
fenv_decay = 0.8
fenv_sustain = 0.25
fenv_release = 0.5
aenv_attack = 0.004
aenv_decay = 1.5
aenv_sustain = 0.7
aenv_release = 0.6
voice_mode = Mono
note_priority = Low
glide_time = 0.05
drift = 0.3
master_volume = -9.6