# Vangelis, "Blade Runner" (1982): the slow, majestic CS-80 brass in a vast space. Two layers (a
# bright high-passed saw and a soft pulse), slow swells, aftertouch opens the filter and adds
# vibrato, plus a delayed per-note vibrato on long notes.
name = Blade Runner (CS-80)
category = '80s Songs
layer_mode = Dual
layer_detune = 6
osc1_wave = Saw
osc1_level = 0.75
vhpf_cutoff = 120
filter_model = IR3109 12dB
filter_cutoff = 600
filter_reso = 0.25
filter_env_amt = 0.45
filter_vel = 0.4
fenv_attack = 0.5
fenv_decay = 1.5
fenv_sustain = 0.6
fenv_release = 1.5
aenv_attack = 0.3
aenv_decay = 1
aenv_sustain = 0.9
aenv_release = 2
amp_vel = 0.3
mx1_source = Aftertouch
mx1_dest = Cutoff
mx1_amount = 0.35
mx2_source = LFO 2
mx2_dest = Pitch
mx2_amount = 0.07
lfo2_rate = 5
lfo2_wave = Sine
lfo2_delay = 1
voice_mode = Poly
pan_spread = 0.3
drift = 0.4
reverb_mix = 0.45
reverb_size = 0.95
reverb_decay = 7
reverb_damping = 0.6
reverb_predelay = 40
master_volume = -16.1

[layer b]
osc1_wave = Pulse
osc1_pw = 0.4
osc1_level = 0.6
filter_model = IR3109 24dB
filter_cutoff = 1200
filter_reso = 0.1
filter_env_amt = 0.15
fenv_attack = 0.8
fenv_decay = 1.5
fenv_sustain = 0.7
fenv_release = 1.5
aenv_attack = 0.5
aenv_decay = 1
aenv_sustain = 0.9
aenv_release = 2.5
mx1_source = Aftertouch
mx1_dest = Pitch
mx1_amount = 0.05
voice_mode = Poly
pan_spread = 0.6
drift = 0.4
chorus_mode = I
reverb_mix = 0.45
reverb_size = 0.95
reverb_decay = 7
reverb_damping = 0.6
reverb_predelay = 40
master_volume = -16.1
