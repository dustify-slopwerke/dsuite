# Donna Summer, "I Feel Love" (1977): Giorgio Moroder's Moog bass sequence. Hold C2 G2 A#2 C3:
# the arpeggiator plays 8ths and a 1/16 ping-pong echo fills in the gallop. Syncs to the host tempo.
name = I Feel Love (Moog Bass)
category = '70s Songs
osc1_wave = Saw
osc1_range = 16'
osc1_level = 0.85
osc2_on = on
osc2_wave = Saw
osc2_range = 16'
osc2_tune = 0.03
osc2_level = 0.6
mixer_drive = 4
filter_cutoff = 450
filter_reso = 0.3
filter_env_amt = 0.45
filter_keytrack = 1/3
fenv_attack = 0.001
fenv_decay = 0.14
fenv_sustain = 0.05
fenv_release = 0.05
aenv_attack = 0.001
aenv_decay = 0.18
aenv_sustain = 0.2
aenv_release = 0.05
voice_mode = Mono
note_priority = Last
arp_on = on
arp_mode = Up
arp_rate = 1/8
arp_gate = 0.45
arp_tempo = 128
drift = 0.2
delay_mode = Ping-Pong
delay_note = 1/16
delay_feedback = 0.15
delay_tone = 5000
delay_mix = 0.35
reverb_mix = 0.1
master_volume = -2.4
