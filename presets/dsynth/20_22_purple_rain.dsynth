# Prince, "Purple Rain" (1984): the warm Oberheim OB-8 string pad. Two detuned saws and a
# slowly modulated 4' pulse through the 12 dB filter, slow attack and release, chorus and hall.
name = Purple Rain (OB-8)
category = '80s Songs
osc1_wave = Saw
osc1_level = 0.75
osc2_on = on
osc2_wave = Saw
osc2_tune = 0.1
osc2_level = 0.75
osc3_on = on
osc3_wave = Pulse
osc3_range = 4'
osc3_pw = 0.35
osc3_level = 0.2
filter_model = SEM 12dB
filter_cutoff = 2400
filter_reso = 0.1
filter_env_amt = 0.1
fenv_attack = 0.3
fenv_decay = 1
fenv_sustain = 0.8
fenv_release = 1.2
aenv_attack = 0.35
aenv_decay = 1
aenv_sustain = 0.95
aenv_release = 1.4
lfo_rate = 0.5
mod_source = LFO
mod_amount = 0.2
mod_pitch = off
mod_pw = on
voice_mode = Poly
pan_spread = 0.6
drift = 0.4
chorus_mode = I
reverb_mix = 0.4
reverb_size = 0.75
reverb_decay = 3.5
master_volume = -15.5
