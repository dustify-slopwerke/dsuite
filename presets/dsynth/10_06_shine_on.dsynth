# Pink Floyd, "Shine On You Crazy Diamond" (1975): Rick Wright's mellow Minimoog lead. Saw and
# square, a gentle filter, legato glide and vibrato that fades in on long notes, in a big room.
name = Shine On (Minimoog)
category = '70s Songs
osc1_wave = Saw
osc1_level = 0.8
osc2_on = on
osc2_wave = Square
osc2_tune = 0.06
osc2_level = 0.5
filter_cutoff = 1100
filter_reso = 0.25
filter_env_amt = 0.25
filter_keytrack = 2/3
fenv_attack = 0.05
fenv_decay = 0.8
fenv_sustain = 0.6
fenv_release = 0.4
aenv_attack = 0.02
aenv_sustain = 1
aenv_release = 0.4
voice_mode = Legato
note_priority = Last
glide_time = 0.1
glide_mode = Legato Only
mod_source = LFO
mod_filter = off
lfo_wave = Sine
lfo_rate = 5.2
lfo_delay = 0.8
mx1_source = LFO
mx1_dest = Pitch
mx1_amount = 0.09
drift = 0.4
