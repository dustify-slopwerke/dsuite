# Madonna, "Into the Groove" (1985): the bright, brassy synth stabs. Two detuned saws and a 4'
# pulse driven into the CEM filter with a punchy contour; velocity adds bite.
name = Into the Groove (Stabs)
category = '80s Songs
osc1_wave = Saw
osc1_level = 0.75
osc2_on = on
osc2_wave = Saw
osc2_tune = 0.12
osc2_level = 0.75
osc3_on = on
osc3_wave = Pulse
osc3_range = 4'
osc3_pw = 0.35
osc3_level = 0.3
mixer_drive = 6
filter_model = CEM 24dB
filter_cutoff = 1400
filter_reso = 0.15
filter_env_amt = 0.45
filter_keytrack = 2/3
filter_vel = 0.3
fenv_attack = 0.005
fenv_decay = 0.25
fenv_sustain = 0.35
fenv_release = 0.2
aenv_attack = 0.003
aenv_decay = 0.35
aenv_sustain = 0.6
aenv_release = 0.2
voice_mode = Poly
pan_spread = 0.5
drift = 0.35
chorus_mode = I
reverb_mix = 0.15
reverb_size = 0.45
reverb_decay = 1.5
master_volume = -15.2
