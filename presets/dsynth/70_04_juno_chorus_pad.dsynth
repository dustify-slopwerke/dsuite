# Warm pad: slow filter swell, bass boost, chorus I + II for the fast shimmer
name = Juno Chorus Pad
category = Pads & Strings
osc_type = DCO
osc1_wave = Saw
osc1_level = 0.7
sub_level = 0.35
filter_model = IR3109 24dB
filter_cutoff = 900
filter_reso = 0.25
filter_env_amt = 0.3
hpf_mode = Bass Boost
fenv_attack = 1.2
fenv_decay = 2
fenv_sustain = 0.6
fenv_release = 1.5
aenv_attack = 0.6
aenv_decay = 1
aenv_sustain = 1
aenv_release = 1.6
voice_mode = Poly
drift = 0.2
chorus_mode = I + II
master_volume = -11.3
reverb_mix = 0.3
reverb_size = 0.75
reverb_decay = 4.5
reverb_damping = 0.6
