# Hot Butter, "Popcorn" (1972): the staccato Moog "plink". Square and saw through a ladder filter
# that snaps shut almost at once; no sustain, so every note pops.
name = Popcorn (Moog)
category = '70s Songs
osc1_wave = Square
osc1_level = 0.8
osc2_on = on
osc2_wave = Saw
osc2_tune = 0.04
osc2_level = 0.4
filter_cutoff = 500
filter_reso = 0.3
filter_env_amt = 0.6
filter_keytrack = 2/3
fenv_attack = 0.001
fenv_decay = 0.15
fenv_sustain = 0
fenv_release = 0.1
aenv_attack = 0.001
aenv_decay = 0.22
aenv_sustain = 0
aenv_release = 0.1
voice_mode = Mono
note_priority = Last
drift = 0.3
reverb_mix = 0.12
reverb_size = 0.4
reverb_decay = 1.2
master_volume = 2.4
