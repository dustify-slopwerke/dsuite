# Madonna, "Holiday" (1983): the bright, tight synth chords. Saw and pulse into the CEM filter
# with a short pluck that settles to a sustain, chorus and a small room.
name = Holiday (Chords)
category = '80s Songs
osc1_wave = Saw
osc1_level = 0.75
osc2_on = on
osc2_wave = Pulse
osc2_pw = 0.35
osc2_tune = 0.07
osc2_level = 0.6
filter_model = CEM 24dB
filter_cutoff = 1800
filter_reso = 0.15
filter_env_amt = 0.35
filter_keytrack = 2/3
filter_vel = 0.25
fenv_attack = 0.001
fenv_decay = 0.3
fenv_sustain = 0.45
fenv_release = 0.25
aenv_attack = 0.002
aenv_decay = 0.4
aenv_sustain = 0.7
aenv_release = 0.25
voice_mode = Poly
pan_spread = 0.5
drift = 0.3
chorus_mode = I
reverb_mix = 0.15
reverb_size = 0.4
reverb_decay = 1.4
master_volume = -10.6
