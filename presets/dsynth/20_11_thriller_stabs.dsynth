# Michael Jackson, "Thriller" (1982): the brassy synth stabs. Three saws (one an octave down)
# through the CEM filter with a fast swell and decay; harder hits are brighter.
name = Thriller (Brass Stabs)
category = '80s Songs
osc1_wave = Saw
osc1_level = 0.75
osc2_on = on
osc2_wave = Saw
osc2_tune = 0.1
osc2_level = 0.75
osc3_on = on
osc3_wave = Saw
osc3_range = 16'
osc3_level = 0.4
filter_model = CEM 24dB
filter_cutoff = 900
filter_reso = 0.2
filter_env_amt = 0.5
filter_keytrack = 2/3
filter_vel = 0.4
fenv_attack = 0.01
fenv_decay = 0.35
fenv_sustain = 0.3
fenv_release = 0.3
aenv_attack = 0.005
aenv_decay = 0.5
aenv_sustain = 0.6
aenv_release = 0.35
voice_mode = Poly
pan_spread = 0.5
drift = 0.35
chorus_mode = I
reverb_mix = 0.25
reverb_decay = 2
master_volume = -8.2
