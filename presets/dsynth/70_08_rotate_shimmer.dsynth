# Shimmer pad: key assign Rotate moves every note to the next voice and each voice has its own
# free-running LFO 2 on pulse width and cutoff, so no two notes move alike.
name = Rotate Shimmer Pad
category = Pads & Strings
osc1_wave = Pulse
osc1_pw = 0.3
osc1_level = 0.7
osc2_on = on
osc2_wave = Saw
osc2_tune = 0.08
osc2_level = 0.5
filter_model = IR3109 24dB
filter_cutoff = 1600
filter_reso = 0.2
filter_env_amt = 0.15
fenv_attack = 0.5
fenv_decay = 1.5
fenv_sustain = 0.7
fenv_release = 1.5
aenv_attack = 0.6
aenv_decay = 1
aenv_sustain = 1
aenv_release = 2
mx1_source = LFO 2
mx1_dest = Osc 1 PW
mx1_amount = 0.35
mx2_source = LFO 2
mx2_dest = Cutoff
mx2_amount = 0.1
lfo2_rate = 0.4
lfo2_wave = Triangle
lfo2_keysync = off
voice_mode = Poly
key_assign = Rotate
pan_spread = 0.8
drift = 0.35
tolerance = 0.6
chorus_mode = I
delay_mode = Ping-Pong
delay_note = 1/4 D
delay_feedback = 0.4
delay_tone = 3000
delay_mix = 0.2
reverb_mix = 0.4
reverb_size = 0.85
reverb_decay = 5
master_volume = -14.7
