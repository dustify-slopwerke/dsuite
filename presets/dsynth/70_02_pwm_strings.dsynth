# Lush poly strings: two pulses with LFO pulse-width modulation from the wheel-mod section
name = PWM Strings
category = Pads & Strings
osc1_wave = Pulse
osc1_pw = 0.35
osc1_level = 0.7
osc2_on = on
osc2_wave = Pulse
osc2_pw = 0.35
osc2_tune = 0.1
osc2_level = 0.7
lfo_rate = 0.7
lfo_wave = Triangle
mod_source = LFO
mod_amount = 0.45
mod_pitch = off
mod_pw = on
filter_model = CEM 24dB
filter_cutoff = 2400
filter_reso = 0.1
filter_env_amt = 0.1
fenv_attack = 0.5
fenv_decay = 1
fenv_sustain = 0.7
fenv_release = 1
aenv_attack = 0.4
aenv_decay = 1
aenv_sustain = 0.9
aenv_release = 1.1
amp_vel = 0.25
voice_mode = Poly
drift = 0.4
tolerance = 0.5
master_volume = -17
