# Sci-fi computer bleeps: hold a note and the sample-and-hold LFO throws the pitch and filter to a
# new random value eight times a second. Lots of echo.
name = S&H Bleeps
category = Bells & FX
osc1_wave = Square
osc1_level = 0.75
filter_cutoff = 1500
filter_reso = 0.55
filter_env_amt = 0.2
fenv_decay = 0.08
fenv_sustain = 0.3
aenv_attack = 0.002
aenv_sustain = 1
aenv_release = 0.4
lfo_rate = 8
lfo_wave = S&H
mx1_source = LFO
mx1_dest = Pitch
mx1_amount = 0.5
mx2_source = LFO
mx2_dest = Cutoff
mx2_amount = 0.25
voice_mode = Mono
drift = 0.2
delay_mode = Ping-Pong
delay_note = 1/8 D
delay_feedback = 0.5
delay_mix = 0.3
reverb_mix = 0.25
master_volume = -3.4
