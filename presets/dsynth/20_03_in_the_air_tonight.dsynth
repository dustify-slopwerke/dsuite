# Phil Collins, "In the Air Tonight" (1981): the dark Prophet-5 chords. Saw and slowly
# modulated pulse into a closed CEM filter, slow swells, long release and a deep, dark space.
name = In the Air Tonight (Prophet-5)
category = '80s Songs
osc1_wave = Saw
osc1_level = 0.75
osc2_on = on
osc2_wave = Pulse
osc2_pw = 0.3
osc2_tune = 0.07
osc2_level = 0.6
filter_model = CEM 24dB
filter_cutoff = 600
filter_reso = 0.3
filter_env_amt = 0.25
fenv_attack = 0.6
fenv_decay = 2
fenv_sustain = 0.6
fenv_release = 1.5
aenv_attack = 0.5
aenv_decay = 2
aenv_sustain = 0.9
aenv_release = 2
lfo_rate = 0.3
mx1_source = LFO
mx1_dest = Osc 2 PW
mx1_amount = 0.3
voice_mode = Poly
pan_spread = 0.5
drift = 0.35
chorus_mode = I
delay_mode = Stereo
delay_note = 1/4
delay_feedback = 0.4
delay_tone = 2500
delay_mix = 0.15
reverb_mix = 0.45
reverb_size = 0.8
reverb_decay = 5
reverb_damping = 0.7
reverb_predelay = 30
master_volume = -11.2
