# Madonna, "Into the Groove" (1985): the rubbery synth bass. Saw and pulse at 16' into a
# resonant 24 dB OTA filter with a bouncy contour, for the octave-hopping line.
name = Into the Groove (Bass)
category = '80s Songs
osc1_wave = Saw
osc1_range = 16'
osc1_level = 0.85
osc2_on = on
osc2_wave = Pulse
osc2_range = 16'
osc2_pw = 0.3
osc2_tune = 0.05
osc2_level = 0.6
mixer_drive = 5
filter_model = IR3109 24dB
filter_cutoff = 400
filter_reso = 0.35
filter_env_amt = 0.45
filter_keytrack = 1/3
filter_vel = 0.25
fenv_attack = 0.001
fenv_decay = 0.2
fenv_sustain = 0.15
fenv_release = 0.1
aenv_attack = 0.002
aenv_decay = 0.25
aenv_sustain = 0.6
aenv_release = 0.08
voice_mode = Mono
note_priority = Last
drift = 0.25
master_volume = -12
