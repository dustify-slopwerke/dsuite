# Mod matrix demo: key-synced LFO wobbling the cutoff, aftertouch adding vibrato
name = Matrix Wobble
category = Bells & FX
osc1_wave = Saw
osc1_range = 16'
osc2_on = on
osc2_wave = Square
osc2_range = 16'
osc2_tune = 0.06
osc2_level = 0.6
filter_model = Ladder 24dB
filter_cutoff = 300
filter_reso = 0.55
filter_env_amt = 0.15
lfo_rate = 4
lfo_wave = Sine
lfo_keysync = on
mx1_source = LFO
mx1_dest = Cutoff
mx1_amount = 0.45
mx2_source = Aftertouch
mx2_dest = Pitch
mx2_amount = 0.12
mx3_source = Velocity
mx3_dest = Cutoff
mx3_amount = 0.2
voice_mode = Mono
note_priority = Last
mixer_drive = 6
master_volume = -9.5