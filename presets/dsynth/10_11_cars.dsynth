# Gary Numan, "Cars" (1979): the Polymoog "Vox Humana" chords. Saw, pulse and a quiet 4' saw,
# slow pulse-width movement and both chorus modes for that thick, slightly seasick ensemble.
name = Cars (Polymoog)
category = '70s Songs
osc1_wave = Saw
osc1_level = 0.75
osc2_on = on
osc2_wave = Pulse
osc2_pw = 0.35
osc2_tune = 0.12
osc2_level = 0.6
osc3_on = on
osc3_wave = Saw
osc3_range = 4'
osc3_tune = -0.08
osc3_level = 0.3
filter_model = IR3109 24dB
filter_cutoff = 1800
filter_reso = 0.15
filter_env_amt = 0.2
fenv_attack = 0.05
fenv_decay = 1
fenv_sustain = 0.6
fenv_release = 0.6
aenv_attack = 0.03
aenv_decay = 1
aenv_sustain = 0.9
aenv_release = 0.5
lfo_rate = 0.8
mod_source = LFO
mod_amount = 0.2
mod_pitch = off
mod_pw = on
voice_mode = Poly
pan_spread = 0.4
drift = 0.4
chorus_mode = I + II
reverb_mix = 0.2
master_volume = -13.8
