# Rush, "Tom Sawyer" (1981): the Oberheim OB-X growl. Hold a low note: two saws through a resonant
# 12 dB filter that opens slowly, the filter envelope pulls osc 2 sharp so the beating speeds up,
# and a slow per-voice LFO keeps it moving.
name = Tom Sawyer (OB-X)
category = '80s Songs
osc1_wave = Saw
osc1_range = 16'
osc1_level = 0.8
osc2_on = on
osc2_wave = Saw
osc2_range = 16'
osc2_tune = 0.15
osc2_level = 0.8
mixer_drive = 6
filter_model = SEM 12dB
filter_cutoff = 300
filter_reso = 0.55
filter_env_amt = 0.6
filter_keytrack = 1/3
fenv_attack = 1.2
fenv_decay = 2.5
fenv_sustain = 0.3
fenv_release = 0.8
aenv_attack = 0.01
aenv_sustain = 1
aenv_release = 0.6
mx1_source = Filter Env
mx1_dest = Osc 2 Pitch
mx1_amount = 0.12
mx2_source = LFO 2
mx2_dest = Cutoff
mx2_amount = 0.12
lfo2_rate = 0.3
lfo2_wave = Sine
voice_mode = Legato
note_priority = Last
glide_time = 0.05
drift = 0.4
reverb_mix = 0.2
reverb_decay = 2.5
master_volume = -18.1
