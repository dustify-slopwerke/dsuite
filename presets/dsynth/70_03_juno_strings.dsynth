# Juno string ensemble: one DCO with saw + LFO-swept pulse, sub, HPF and chorus II
name = Juno Strings
category = Pads & Strings
osc_type = DCO
osc1_wave = Saw+Pulse
osc1_pw = 0.3
osc1_level = 0.6
sub_level = 0.25
lfo_rate = 0.6
mod_source = LFO
mod_amount = 0.4
mod_pitch = off
mod_pw = on
filter_model = IR3109 24dB
filter_cutoff = 3200
filter_reso = 0.1
filter_env_amt = 0.05
hpf_mode = 1
fenv_attack = 0.4
fenv_decay = 1
fenv_sustain = 0.8
fenv_release = 1
aenv_attack = 0.35
aenv_decay = 1
aenv_sustain = 0.9
aenv_release = 1
amp_vel = 0.2
voice_mode = Poly
drift = 0.2
tolerance = 0.3
chorus_mode = II
master_volume = -7.6
reverb_mix = 0.25
reverb_size = 0.6
reverb_decay = 2.8
