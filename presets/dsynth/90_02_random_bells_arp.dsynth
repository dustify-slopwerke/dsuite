# Random bell arpeggio: hold a chord and the arpeggiator picks notes at random over two octaves;
# cross-mod and a short decay make each one a little bell. Werckmeister III tuning for colour.
name = Random Bells Arp
category = Sequences & Arps
osc1_wave = Sine
osc1_level = 0.8
osc2_on = on
osc2_wave = Sine
osc2_range = 4'
osc2_tune = 7
osc2_level = 0
cross_mod = 0.35
filter_model = IR3109 12dB
filter_cutoff = 3000
filter_env_amt = 0.2
fenv_decay = 0.3
fenv_sustain = 0
aenv_attack = 0.001
aenv_decay = 0.8
aenv_sustain = 0
aenv_release = 0.8
voice_mode = Poly
pan_spread = 0.7
arp_on = on
arp_mode = Random
arp_rate = 1/16
arp_octaves = 2
arp_gate = 0.8
tuning = Werckmeister III
drift = 0.2
delay_mode = Ping-Pong
delay_note = 1/8 D
delay_feedback = 0.4
delay_mix = 0.25
reverb_mix = 0.35
reverb_decay = 3.5
master_volume = -10.5
