# ELP, "Lucky Man" (1970): Keith Emerson's Moog modular solo. Brassy saws plus a square an octave
# down, glide on every note (play legato or not, it always slides), wheel for vibrato.
name = Lucky Man (Moog Modular)
category = '70s Songs
osc1_wave = Saw
osc1_level = 0.8
osc2_on = on
osc2_wave = Saw
osc2_tune = 0.08
osc2_level = 0.75
osc3_on = on
osc3_wave = Square
osc3_range = 16'
osc3_level = 0.5
mixer_drive = 4
filter_cutoff = 1300
filter_reso = 0.3
filter_env_amt = 0.3
filter_keytrack = 2/3
fenv_attack = 0.03
fenv_decay = 0.5
fenv_sustain = 0.7
fenv_release = 0.3
aenv_attack = 0.01
aenv_sustain = 1
aenv_release = 0.3
voice_mode = Mono
note_priority = Last
glide_time = 0.22
mod_source = LFO
mod_filter = off
lfo_wave = Sine
lfo_rate = 5.5
drift = 0.4
reverb_mix = 0.2
reverb_decay = 2.5
master_volume = -12.3
