# Metallic bell from Jupiter-style cross-mod: silent osc 2 frequency-modulates osc 1
name = Cross-Mod Bell
category = Bells & FX
osc1_wave = Sine
osc1_level = 0.9
osc2_on = off
osc2_wave = Square
osc2_range = 4'
osc2_tune = 0.37
cross_mod = 0.45
filter_model = IR3109 24dB
filter_cutoff = 5000
filter_reso = 0
filter_env_amt = 0.2
fenv_attack = 0.001
fenv_decay = 1.5
fenv_sustain = 0
aenv_attack = 0.001
aenv_decay = 2.5
aenv_sustain = 0
aenv_release = 1.5
amp_vel = 0.5
voice_mode = Poly
pan_spread = 0.4
chorus_mode = I
master_volume = -11.4